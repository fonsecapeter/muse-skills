#!/usr/bin/env python3
"""Append a dated learning to a custom skill's learnings.md.

Reads skills_dirs and timezone from ../config.md (the ```json
fenced block); falls back to the skills_dir key. Since the 2026-11-05
consolidation there is exactly one skill tree: ~/workspace/custom-skills.

Skill names are matched after stripping a leading local-/local_
prefix, so a skill resolves by its bare name or its legacy
prefixed name.

Usage:
    bin/record-learning <skill-name> "<learning>"
"""
import json
import re
import sys
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

SKILL_DIR = Path(__file__).resolve().parent.parent


def load_config():
    text = (SKILL_DIR / "config.md").read_text()
    block = re.search(r"```json\s*(.*?)```", text, re.S).group(1)
    cfg = json.loads(block)
    dirs = cfg.get("skills_dirs") or [cfg["skills_dir"]]
    cfg["skills_dirs"] = [Path(d).expanduser() for d in dirs]
    return cfg


def norm(name):
    for prefix in ("local-", "local_"):
        if name.startswith(prefix):
            return name[len(prefix):]
    return name


def main():
    if len(sys.argv) != 3:
        sys.exit('usage: record-learning <skill-name> "<learning>"')
    skill, text = sys.argv[1], sys.argv[2]
    cfg = load_config()
    target = None
    for base in cfg["skills_dirs"]:
        if not base.is_dir():
            continue
        for sub in sorted(base.iterdir()):
            if sub.is_dir() and (sub.name == skill or norm(sub.name) == norm(skill)):
                target = sub
                break
        if target is not None:
            break
    if target is None:
        sys.exit(f"no such skill: {skill}")
    log = target / "learnings.md"
    if not log.exists():
        log.write_text(
            f"# Learnings — {skill}\n\nPending learnings for the nightly "
            "sweep. Implemented entries are moved to the central learned log "
            "(~/workspace/custom-skills/learning-loop/learned.md), then removed here.\n\n## Pending\n"
        )
    date = datetime.now(ZoneInfo(cfg["timezone"])).strftime("%Y-%m-%d")
    with log.open("a") as f:
        f.write(f"- [{date}] {text}\n")
    print(f"recorded: {log}")


if __name__ == "__main__":
    main()
