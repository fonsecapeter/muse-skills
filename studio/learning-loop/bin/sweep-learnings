#!/usr/bin/env python3
"""List pending learnings across all custom skills, clear a skill's log,
record an implemented learning in the central learned log, or review
recent learned entries.

Reads skills_dirs and timezone from ../config.md (the ```json
fenced block); falls back to the skills_dir key. Since the 2026-11-05
consolidation there is exactly one skill tree: ~/workspace/custom-skills.

Skill names are matched after stripping a leading local-/local_
prefix, so a skill resolves by its bare name or its legacy
prefixed name.

Usage:
    bin/sweep-learnings                       # list all pending learnings
    bin/sweep-learnings --clear <skill>       # reset a skill's log after implementation
    bin/sweep-learnings --learned <skill> "<learning>" "<change>"
        # move an implemented learning into the central learned.md log
    bin/sweep-learnings --recent [N]          # show the last N learned entries (default 20)
"""
import json
import re
import sys
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

SKILL_DIR = Path(__file__).resolve().parent.parent


def load_config():
    text = (SKILL_DIR / "config.md").read_text()
    block = re.search(r"```json\s*(.*?)```", text, re.S).group(1)
    cfg = json.loads(block)
    dirs = cfg.get("skills_dirs") or [cfg["skills_dir"]]
    cfg["skills_dirs"] = [Path(d).expanduser() for d in dirs]
    return cfg


def norm(name):
    for prefix in ("local-", "local_"):
        if name.startswith(prefix):
            return name[len(prefix):]
    return name


def find_skill_dirs(cfg, skill):
    """All skill directories matching skill (exact or prefix-normalized)."""
    found = []
    for base in cfg["skills_dirs"]:
        if not base.is_dir():
            continue
        for sub in sorted(base.iterdir()):
            if sub.is_dir() and (sub.name == skill or norm(sub.name) == norm(skill)):
                found.append(sub)
    return found


def pending_header(skill):
    return (
        f"# Learnings — {skill}\n\nPending learnings for the nightly "
        "sweep. Implemented entries are moved to the central learned log "
        "(~/workspace/custom-skills/learning-loop/learned.md), then removed here.\n\n## Pending\n"
    )


def learned_header():
    return (
        "# Learned — implemented skill learnings\n\n"
        "Every entry: the learning that surfaced, the change made in "
        "response, and the skill that changed. Written by the nightly "
        "sweep via `bin/sweep-learnings --learned`. Newest entries last; "
        "the sweep reviews recent entries for broader patterns.\n\n"
    )


def cmd_list(cfg):
    found = False
    for base in cfg["skills_dirs"]:
        if not base.is_dir():
            continue
        for log in sorted(base.glob("*/learnings.md")):
            entries = [ln for ln in log.read_text().splitlines() if ln.startswith("- ")]
            if entries:
                found = True
                print(f"== {base.name}/{log.parent.name}/learnings.md ==")
                print("\n".join(entries))
    if not found:
        print("no pending learnings")


def cmd_clear(cfg, skill):
    targets = [d for d in find_skill_dirs(cfg, skill) if (d / "learnings.md").exists()]
    if not targets:
        sys.exit(f"no learnings file for {skill}")
    for d in targets:
        (d / "learnings.md").write_text(pending_header(norm(d.name)))
        print(f"cleared pending learnings for {skill} ({d})")


def cmd_learned(cfg, skill, learning, change):
    if not find_skill_dirs(cfg, skill):
        sys.exit(f"no such skill: {skill}")
    log = SKILL_DIR / "learned.md"
    if not log.exists():
        log.write_text(learned_header())
    date = datetime.now(ZoneInfo(cfg["timezone"])).strftime("%Y-%m-%d")
    with log.open("a") as f:
        f.write(f"### {date} — {skill}\n")
        f.write(f"- **Learning:** {learning}\n")
        f.write(f"- **Change:** {change}\n\n")
    print(f"learned: {log}")


def cmd_recent(n):
    log = SKILL_DIR / "learned.md"
    if not log.exists():
        print("no learned entries yet")
        return
    text = log.read_text()
    # entries are "### <date> — <skill>\n- **Learning:** ...\n- **Change:** ...\n\n"
    entries = re.findall(r"### .*?(?=\n### |\Z)", text, re.S)
    entries = [e.strip() for e in entries if e.strip().startswith("###")]
    if not entries:
        print("no learned entries yet")
        return
    for e in entries[-n:]:
        print(e)
        print()


def main():
    cfg = load_config()
    argv = sys.argv[1:]
    if not argv:
        cmd_list(cfg)
    elif argv[0] == "--clear" and len(argv) == 2:
        cmd_clear(cfg, argv[1])
    elif argv[0] == "--learned" and len(argv) == 4:
        cmd_learned(cfg, argv[1], argv[2], argv[3])
    elif argv[0] == "--recent" and len(argv) <= 2:
        n = int(argv[1]) if len(argv) == 2 else 20
        cmd_recent(n)
    else:
        sys.exit(
            "usage: sweep-learnings [--clear <skill>] "
            '[--learned <skill> "<learning>" "<change>"] [--recent [N]]'
        )


if __name__ == "__main__":
    main()
