#!/usr/bin/env python3
"""List pending learnings from the central learning log, or drop a
skill's entries once they are implemented.

All pending learnings live in one file — the central log at
<log_dir>/learnings.md (log_dir from ../config.md, outside the
skill repo). Each entry is one line tagged with its skill:

    - [2026-11-06] [simi-claims] the learning text

There is no separate learned log: what changed in response to a
learning is recorded by the repo itself, in the sweep's diff and
its description.

Usage:
    bin/sweep-learnings              # list all pending learnings
    bin/sweep-learnings --drop <skill>
        # remove that skill's pending entries (after implementing
        # them) and print what was removed
"""
import json
import re
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
ENTRY = re.compile(r"^- \[[^\]]*\] \[([^\]]*)\] ")


def load_config():
    text = (SKILL_DIR / "config.md").read_text()
    block = re.search(r"```json\s*(.*?)```", text, re.S).group(1)
    cfg = json.loads(block)
    cfg["log_dir"] = Path(cfg.get("log_dir", "~/workspace/learning-log")).expanduser()
    return cfg


def norm(name):
    for prefix in ("local-", "local_"):
        if name.startswith(prefix):
            return name[len(prefix):]
    return name


def log_path(cfg):
    return cfg["log_dir"] / "learnings.md"


def read_lines(cfg):
    log = log_path(cfg)
    return log.read_text().splitlines() if log.exists() else []


def cmd_list(cfg):
    entries = [ln for ln in read_lines(cfg) if ENTRY.match(ln)]
    if not entries:
        print("no pending learnings")
        return
    for ln in entries:
        print(ln)


def cmd_drop(cfg, skill):
    log = log_path(cfg)
    if not log.exists():
        print(f"no pending learnings for {skill}")
        return
    lines = read_lines(cfg)
    kept, dropped = [], []
    for ln in lines:
        m = ENTRY.match(ln)
        if m and norm(m.group(1)) == norm(skill):
            dropped.append(ln)
        else:
            kept.append(ln)
    if not dropped:
        print(f"no pending learnings for {skill}")
        return
    log.write_text("\n".join(kept) + "\n")
    print(f"dropped {len(dropped)} implemented learning(s) for {skill}:")
    for ln in dropped:
        print(ln)


def main():
    cfg = load_config()
    argv = sys.argv[1:]
    if not argv:
        cmd_list(cfg)
    elif argv[0] == "--drop" and len(argv) == 2:
        cmd_drop(cfg, argv[1])
    else:
        sys.exit("usage: sweep-learnings [--drop <skill>]")


if __name__ == "__main__":
    main()
