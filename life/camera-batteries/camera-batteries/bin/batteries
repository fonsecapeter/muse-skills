#!/usr/bin/env python3
# batteries — read Peter's local device registry and resolve a
# device (or an Inventory item naming one) to the batteries it
# takes. The batteries themselves are items in the inventory
# skill's catalog, read through its CLI; the registry holds only
# devices, whose slots reference catalog item ids.
# Usage:
#   bin/batteries list               devices, slots resolved, as JSON
#   bin/batteries resolve "<text>"   devices named in the text,
#                                    with their battery slots
#                                    resolved to battery specs
# The registry lives in the local config named in config.json
# (outside the repo). This CLI never orders anything. Fails loudly
# (stderr + non-zero exit) on any bad config or unmatched text.
import argparse
import json
import os
import subprocess
import sys

SKILL_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def fail(msg):
    print(f"batteries: {msg}", file=sys.stderr)
    sys.exit(1)


def load_json(path, what):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception as e:
        fail(f"cannot load {what} ({path}): {e}")


def skill_cfg():
    return load_json(os.path.join(SKILL_DIR, "config.json"), "config.json")


def registry():
    return load_json(os.path.expanduser(skill_cfg()["local_config"]),
                     "local device registry")


def catalog_items():
    items_cli = os.path.expanduser(skill_cfg()["items_cli"])
    r = subprocess.run([items_cli, "items"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"inventory CLI failed reading the catalog: "
             f"{r.stderr.strip()[:300]}")
    try:
        return json.loads(r.stdout).get("items", [])
    except Exception:
        fail(f"unparseable catalog response: {r.stdout[:200]}")


def resolve_device(reg, device):
    by_id = {b["id"]: b for b in catalog_items()}
    slots = []
    for slot in device.get("slots", []):
        battery = by_id.get(slot["battery_id"])
        if battery is None:
            fail(f"device {device['id']!r} names unknown battery "
                 f"{slot['battery_id']!r}")
        slots.append({**battery, "quantity": slot["quantity"]})
    return {**device, "slots": slots}


def cmd_list(_args):
    reg = registry()
    print(json.dumps({
        "devices": [resolve_device(reg, d)
                    for d in reg.get("devices", [])],
    }, indent=2))


def device_matches(device, text):
    names = [device.get("id", "").replace("-", " "),
             device.get("name", "")]
    names += device.get("aliases", [])
    return any(n and n.lower() in text for n in names)


def cmd_resolve(args):
    reg = registry()
    text = args.text.lower()
    hits = [d for d in reg.get("devices", [])
            if device_matches(d, text)]
    if not hits:
        named = [b for b in catalog_items()
                 if b.get("type") == "battery"
                 and (b.get("name", "").lower() in text
                      or b.get("id", "").lower() in text)]
        if named:
            ids = {b["id"] for b in named}
            hits = [d for d in reg.get("devices", [])
                    if any(s["battery_id"] in ids
                           for s in d.get("slots", []))]
    if not hits:
        fail(f"no device or battery matches {args.text!r}")
    print(json.dumps([resolve_device(reg, d) for d in hits], indent=2))


def main():
    parser = argparse.ArgumentParser(prog="batteries")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    p_resolve = sub.add_parser("resolve")
    p_resolve.add_argument("text")
    args = parser.parse_args()
    {"list": cmd_list, "resolve": cmd_resolve}[args.command](args)


if __name__ == "__main__":
    main()
