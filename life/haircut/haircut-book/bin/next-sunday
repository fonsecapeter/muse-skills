#!/usr/bin/env python3
"""Print the upcoming Sunday's date as YYYY-MM-DD in America/Los_Angeles.
If today is Sunday, returns today."""
import datetime

try:
    from zoneinfo import ZoneInfo
    now = datetime.datetime.now(ZoneInfo("America/Los_Angeles"))
except Exception:
    now = datetime.datetime.now()

days_ahead = (6 - now.weekday()) % 7  # Monday=0 ... Sunday=6
target = now + datetime.timedelta(days=days_ahead)
print(target.strftime("%Y-%m-%d"))
