#!/usr/bin/env python3
# restock — read and maintain the local HH Kitchen restock config,
# and read Peter's Google Tasks Inventory list.
# Usage:
#   bin/restock list                 grouped items + spec cards, as JSON
#   bin/restock inventory            open Inventory items, as JSON
#   bin/restock resolve "<term>"     the one entry a shorthand names
#   bin/restock learn "<name>" [--product P] [--brand B]
#                    [--shorthand S] [--quantity Q] [--notes N]
#   bin/restock complete "<title>"   mark an Inventory task complete
#   bin/restock log-order "<text>"   append an order record locally
# The skill's config.json names the local config file (outside the
# repo) and the tasks CLI. This CLI never touches a cart or an order.
# Fails loudly (stderr + non-zero exit) on any bad config, ambiguous
# shorthand, or failed read.
import argparse
import json
import re
import os
import subprocess
import sys

SKILL_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def fail(msg):
    print(f"restock: {msg}", file=sys.stderr)
    sys.exit(1)


def load_json(path, what):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception as e:
        fail(f"cannot load {what} ({path}): {e}")


def skill_config():
    return load_json(os.path.join(SKILL_DIR, "config.json"), "config.json")


def local_config_path():
    return os.path.expanduser(skill_config()["local_config"])


def local_config():
    return load_json(local_config_path(), "local restock config")


def save_local_config(cfg):
    path = local_config_path()
    try:
        with open(path, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
    except Exception as e:
        fail(f"cannot write local restock config ({path}): {e}")


def all_entries(cfg):
    return (cfg.get("line", []) + cfg.get("backstock", [])
            + cfg.get("specials", []) + cfg.get("learned", []))


def cmd_list(_args):
    cfg = local_config()
    print(json.dumps({
        "store": cfg.get("store", {}),
        "line": cfg.get("line", []),
        "backstock": cfg.get("backstock", []),
        "specials": cfg.get("specials", []),
        "learned": cfg.get("learned", []),
        "spec_cards": cfg.get("spec_cards", []),
        "orders": cfg.get("orders", []),
    }, indent=2))


def find_inventory_list_id(tasks_cli, title):
    r = subprocess.run([tasks_cli, "tasks", "tasklists", "list"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"tasks CLI failed listing task lists: {r.stderr.strip()[:300]}")
    try:
        lists = json.loads(r.stdout).get("items", [])
    except Exception:
        fail(f"unparseable task lists response: {r.stdout[:200]}")
    for lst in lists:
        if lst.get("title") == title:
            return lst["id"]
    fail(f"no Google Tasks list titled {title!r}")


def cmd_inventory(_args):
    cfg = skill_config()
    list_id = find_inventory_list_id(cfg["tasks_cli"],
                                     cfg["inventory_list_title"])
    params = json.dumps({"tasklist": list_id, "showCompleted": False})
    r = subprocess.run([cfg["tasks_cli"], "tasks", "tasks", "list",
                        "--params", params],
                       capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"tasks CLI failed reading Inventory: {r.stderr.strip()[:300]}")
    try:
        items = json.loads(r.stdout).get("items", [])
    except Exception:
        fail(f"unparseable Inventory response: {r.stdout[:200]}")
    open_items = [{"title": i.get("title", ""), "notes": i.get("notes", "")}
                  for i in items if i.get("status") != "completed"]
    print(json.dumps(open_items, indent=2))


def matches(entry, term):
    term = term.strip().lower()
    names = [entry.get("id", ""), entry.get("name", ""),
             entry.get("shorthand", "")]
    names += entry.get("aliases", [])
    return term in [n.lower() for n in names if n]


def slug_id(name):
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower().replace("'", "")).strip("-")
    return slug


def cmd_resolve(args):
    cfg = local_config()
    hits = [e for e in all_entries(cfg) if matches(e, args.term)]
    if not hits:
        fail(f"no entry matches {args.term!r}")
    if len(hits) > 1:
        names = ", ".join(e.get("name", "?") for e in hits)
        fail(f"{args.term!r} is ambiguous: {names}")
    print(json.dumps(hits[0], indent=2))


def run_tasks(cfg, *cli_args):
    r = subprocess.run([cfg["tasks_cli"], "tasks", *cli_args],
                       capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"tasks CLI failed ({' '.join(cli_args)}): "
             f"{r.stderr.strip()[:300]}")
    try:
        return json.loads(r.stdout)
    except Exception:
        fail(f"unparseable tasks response: {r.stdout[:200]}")


def open_inventory_tasks(cfg):
    list_id = find_inventory_list_id(cfg["tasks_cli"],
                                     cfg["inventory_list_title"])
    params = json.dumps({"tasklist": list_id, "showCompleted": False})
    d = run_tasks(cfg, "tasks", "list", "--params", params)
    return list_id, [i for i in d.get("items", [])
                     if i.get("status") != "completed"]


def cmd_complete(args):
    cfg = skill_config()
    list_id, tasks = open_inventory_tasks(cfg)
    hits = [t for t in tasks
            if t.get("title", "").lower() == args.title.lower()]
    if not hits:
        fail(f"no open Inventory task titled {args.title!r}")
    if len(hits) > 1:
        fail(f"{len(hits)} open Inventory tasks titled {args.title!r}")
    task = hits[0]
    params = json.dumps({"tasklist": list_id, "task": task["id"]})
    run_tasks(cfg, "tasks", "patch", "--params", params,
              "--json", json.dumps({"status": "completed"}))
    _, remaining = open_inventory_tasks(cfg)
    if any(t["id"] == task["id"] for t in remaining):
        fail(f"task {args.title!r} still open after patch")
    print(json.dumps({"completed": task.get("title", "")}, indent=2))


def cmd_log_order(args):
    cfg = local_config()
    from datetime import datetime, timezone
    record = {"at": datetime.now(timezone.utc).isoformat(),
              "summary": args.summary}
    cfg.setdefault("orders", []).append(record)
    save_local_config(cfg)
    print(json.dumps(record, indent=2))


def cmd_learn(args):
    cfg = local_config()
    learned = cfg.setdefault("learned", [])
    entry = next((e for e in learned
                  if e.get("name", "").lower() == args.name.lower()), None)
    if entry is None:
        entry = {"id": slug_id(args.name), "name": args.name,
                 "shorthand": "", "aliases": [],
                 "product": "", "brand": "", "default_quantity": 1,
                 "action": "ask", "notes": ""}
        learned.append(entry)
    for field in ("product", "brand", "shorthand", "notes"):
        value = getattr(args, field)
        if value is not None:
            entry[field] = value
    if args.quantity is not None:
        entry["default_quantity"] = args.quantity
    save_local_config(cfg)
    print(json.dumps(entry, indent=2))


def main():
    parser = argparse.ArgumentParser(prog="restock")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    sub.add_parser("inventory")
    p_resolve = sub.add_parser("resolve")
    p_resolve.add_argument("term")
    p_learn = sub.add_parser("learn")
    p_learn.add_argument("name")
    p_learn.add_argument("--product")
    p_learn.add_argument("--brand")
    p_learn.add_argument("--shorthand")
    p_learn.add_argument("--quantity", type=int)
    p_learn.add_argument("--notes")
    p_complete = sub.add_parser("complete")
    p_complete.add_argument("title")
    p_order = sub.add_parser("log-order")
    p_order.add_argument("summary")
    args = parser.parse_args()
    {"list": cmd_list, "inventory": cmd_inventory,
     "resolve": cmd_resolve, "learn": cmd_learn,
     "complete": cmd_complete, "log-order": cmd_log_order}[args.command](args)


if __name__ == "__main__":
    main()
