#!/usr/bin/env python3
"""Call the Notion API with the connected custom.notion credential.

Usage:
    notion-api GET /users/me
    notion-api POST /search --data '{"filter":{"property":"object","value":"database"}}'
"""
import argparse
import json
import sys
import urllib.request

import os

# dynamic_credentials moves between deployments; find it, don't assume.
for _cand in (
    "/opt/muse/skills/custom-connector-setup/bin",
    "/opt/hatch/skills/skill-creator/bin",
    "/opt/muse/skills/skill-creator/bin",
):
    if os.path.exists(os.path.join(_cand, "dynamic_credentials.py")):
        sys.path.insert(0, _cand)
        break
else:
    sys.exit("notion-api: dynamic_credentials.py not found in any known location")
from dynamic_credentials import (
    add_surrogate_to_request,
    read_json_response,
)

BASE = "https://api.notion.com/v1"
NOTION_VERSION = "2022-06-28"


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("method", help="HTTP method, e.g. GET or POST")
    parser.add_argument("path", help="API path, e.g. /users/me or /search")
    parser.add_argument("--data", default=None, help="JSON request body")
    args = parser.parse_args()

    body = args.data.encode("utf-8") if args.data else None
    request = urllib.request.Request(
        BASE + args.path, data=body, method=args.method.upper()
    )
    request.add_header("Notion-Version", NOTION_VERSION)
    request.add_header("Content-Type", "application/json")
    add_surrogate_to_request(
        request, "custom.notion", allowed_hosts=["api.notion.com"]
    )
    with urllib.request.urlopen(request) as response:
        print(json.dumps(read_json_response(response), indent=2))


if __name__ == "__main__":
    main()
