#!/usr/bin/env python3
"""Deterministic full-list snapshot of Peter's open Notion TODOs.

Reads config.md, queries Notion (via the notion skill's bin/notion-api CLI)
for all open todos, and prints JSON:

    {"as_of": "2026-09-14", "notion_ok": true, "todos": [...]}

Each todo: {"title", "project", "priority" ("P1"/"P2"/"P3"/null),
"due" ("YYYY-MM-DD"/null), "created" ("YYYY-MM-DD"),
"days_overdue" (int, 0 when not overdue)}.

Sorted: P1 first, then P2, P3, unprioritized; due dates earliest first.
On Notion failure prints {"notion_ok": false, ...} and exits 0.
"""
import datetime
import json
import os
import re
import subprocess
from zoneinfo import ZoneInfo

SKILL_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROJECTS_DB = None  # discovered from the TODO db's Project relation at runtime

PRIORITY_RANK = {"P0": 0, "P1": 1, "P2": 2}


def load_config():
    text = open(os.path.join(SKILL_DIR, "config.md")).read()
    m = re.search(r"```json\n(.*?)\n```", text, re.S)
    if not m:
        raise RuntimeError("config.md has no fenced json block")
    return json.loads(m.group(1))


def notion(method, path, data=None):
    cmd = [os.path.expanduser(load_config()["notion_api"]), method, path]
    if data is not None:
        cmd += ["--data", json.dumps(data)]
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip()[-300:] or "notion-api failed")
    return json.loads(proc.stdout)


def project_names():
    resp = notion("POST", f"/databases/{PROJECTS_DB}/query",
                 {"page_size": 100})
    names = {}
    for p in resp.get("results", []):
        for prop in p["properties"].values():
            if prop["type"] == "title":
                names[p["id"]] = "".join(
                    t["plain_text"] for t in prop["title"])
                break
    return names


def main():
    global PROJECTS_DB
    cfg = load_config()
    todo_db = cfg["notion_todo_database_id"]
    closed = cfg.get("closed_statuses", ["Done", "Not Doing"])
    today = datetime.datetime.now(ZoneInfo(cfg["timezone"])).date()

    out = {"as_of": today.isoformat(), "notion_ok": True, "todos": []}
    try:
        schema = notion("GET", f"/databases/{todo_db}")
        PROJECTS_DB = schema["properties"]["Project"]["relation"]["database_id"]
        names = project_names()

        todos, cursor = [], None
        while True:
            payload = {
                "filter": {"and": [
                    *[{"property": "Status", "status": {"does_not_equal": s}}
                      for s in closed],
                ]},
                "page_size": 100,
            }
            if cursor:
                payload["start_cursor"] = cursor
            resp = notion("POST", f"/databases/{todo_db}/query", payload)
            todos.extend(resp.get("results", []))
            if not resp.get("has_more"):
                break
            cursor = resp["next_cursor"]

        for p in todos:
            props = p["properties"]
            title = "".join(t["plain_text"] for t in props["Task"]["title"])
            sel = props["Priority"]["select"]
            priority = sel["name"] if sel else None
            due_raw = (props["Due"]["date"] or {}).get("start", "")
            due = due_raw[:10] or None
            rels = props["Project"]["relation"]
            project = names.get(rels[0]["id"], "?") if rels else "-"
            created = p["created_time"][:10]
            days_overdue = (max(0, (today - datetime.date.fromisoformat(due)).days)
                            if due else 0)
            out["todos"].append({
                "title": title, "project": project, "priority": priority,
                "due": due, "created": created, "days_overdue": days_overdue,
            })

        out["todos"].sort(key=lambda t: (
            PRIORITY_RANK.get(t["priority"], 3),
            t["due"] or "9999-12-31",
            t["project"], t["title"],
        ))
    except Exception as e:  # noqa: BLE001 - report, don't crash the cron
        out = {"as_of": today.isoformat(), "notion_ok": False,
               "todos": [], "error": str(e)[:200]}

    print(json.dumps(out))


if __name__ == "__main__":
    main()
